{
  "name": "repair-relay-webmcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An evidence-first shared repair bench for people and browser agents, powered by WebMCP.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "vite",
    "serve": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.js",
    "eval": "node scripts/evals.mjs",
    "luna": "node scripts/luna-review.mjs",
    "check": "npm run test && npm run eval && npm run luna",
    "verify:repo": "node scripts/verify-repository.mjs",
    "test:browser": "node scripts/browser-smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "vite": "^8.2.2"
  }
}
