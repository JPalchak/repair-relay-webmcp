{
  "name": "repair-relay-webmcp",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "A live product-label verification workspace for people and browser agents, powered by WebMCP and Open Food Facts.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "vite",
    "serve": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.js",
    "eval": "node scripts/evals.mjs",
    "test:live": "node scripts/live-data-smoke.mjs",
    "check": "npm run test && npm run eval && npm run verify:repo",
    "verify:repo": "node scripts/verify-repository.mjs",
    "test:browser": "node scripts/browser-smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "vite": "^8.2.2"
  }
}
